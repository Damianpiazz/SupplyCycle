<%- include('../layouts/header') %>

<a href="/admin/clientes" class="secondary outline small-btn" style="margin-bottom:1rem;display:inline-block;">&larr; Volver</a>

<article style="margin-bottom:1rem;">
  <header class="flex justify-between items-center">
    <span><strong><%= cliente.apellido %>, <%= cliente.nombre %></strong></span>
    <span class="<%= cliente.activo ? 'badge-activo' : 'badge-inactivo' %>" style="font-size:1rem;"><%= cliente.activo ? 'Activo' : 'Inactivo' %></span>
  </header>
  <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div>
      <h6>Contacto</h6>
      <p style="margin-bottom:0.25rem;">Teléfono: <strong><%= cliente.telefono %></strong></p>
    </div>
    <div>
      <h6>Dirección</h6>
      <% const dom = cliente.domicilios?.[0]; %>
      <p style="margin-bottom:0.25rem;"><%= dom?.calle ?? '' %> <%= dom?.numero ?? '' %></p>
      <p style="margin-bottom:0.25rem;"><%= dom?.localidad ?? '' %></p>
    </div>
  </div>
  <hr>
  <div class="grid" style="grid-template-columns: 1fr 1fr; gap: 1rem;">
    <div>
      <h6>Horarios de entrega</h6>
      <% const dia = dom?.dias?.[0]; %>
      <% const horario = dia?.horarios?.[0]; %>
      <p style="margin-bottom:0.25rem;">Día: <strong><%= dia?.nombre ? dia.nombre.charAt(0).toUpperCase() + dia.nombre.slice(1).toLowerCase() : '-' %></strong></p>
      <p style="margin-bottom:0.25rem;">Horario: <strong><%= horario?.inicio ?? '-' %> - <%= horario?.fin ?? '-' %></strong></p>
    </div>
    <div>
      <h6>Observaciones</h6>
      <p><%= cliente.observaciones || 'Sin observaciones' %></p>
    </div>
  </div>
</article>

<% if (typeof saldoEnvases !== 'undefined' && saldoEnvases.length > 0) { %>
<article style="margin-bottom:1rem;">
  <header>
    <strong>Saldo de Envases Pendientes</strong>
  </header>
  <table>
    <thead><tr><th>Tipo de Envase</th><th>Cantidad Pendiente</th></tr></thead>
    <tbody>
      <% saldoEnvases.forEach(s => { %>
        <tr><td><%= s.itemNombre %></td><td><%= s.cantidad %></td></tr>
      <% }) %>
    </tbody>
  </table>
</article>
<% } %>

<% if (typeof retenidos !== 'undefined' && retenidos.length > 0) { %>
<article style="margin-bottom:1rem;">
  <header>
    <strong>Historial de Envases</strong>
  </header>
  <table>
    <thead><tr><th>Tipo de Envase</th><th>Fecha de Entrega</th><th>Fecha de Devolución</th><th>Estado</th><th>Pedido</th></tr></thead>
    <tbody>
      <% retenidos.forEach(r => { %>
        <tr>
          <td><%= r.item.nombre %></td>
          <td><%= r.inicio.toLocaleDateString() %></td>
          <td><%= r.fin ? r.fin.toLocaleDateString() : '-' %></td>
          <td>
            <span class="<%= r.estado === 'RETENIDO' ? 'badge-pendiente' : (r.estado === 'DEVUELTO' ? 'badge-success' : 'badge-danger') %>" style="font-size:1rem;">
              <%= r.estado.charAt(0) + r.estado.slice(1).toLowerCase() %>
            </span>
          </td>
          <td><%= r.pedido.numeroPedido %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</article>
<% } %>

<% if (typeof frecuencia !== 'undefined' && frecuencia && frecuencia.totalPedidosAnalizados > 0) { %>
<article style="margin-bottom:1rem;">
  <header>
    <strong>Frecuencia de Pedidos</strong>
  </header>
  <table>
    <tbody>
      <% if (frecuencia.intervaloPromedioDias !== null) { %>
        <tr>
          <td style="font-weight:600;width:220px;">Intervalo promedio</td>
          <td>cada <strong><%= frecuencia.intervaloPromedioDias %></strong> día<%= frecuencia.intervaloPromedioDias !== 1 ? 's' : '' %></td>
        </tr>
      <% } %>
      <% if (frecuencia.diaSemanaFrecuente !== null) { %>
        <tr>
          <td style="font-weight:600;">Día más frecuente</td>
          <td><strong><%= frecuencia.diaSemanaFrecuente.charAt(0) + frecuencia.diaSemanaFrecuente.slice(1).toLowerCase() %></strong></td>
        </tr>
      <% } %>
      <tr>
        <td style="font-weight:600;">Total de pedidos analizados</td>
        <td><%= frecuencia.totalPedidosAnalizados %></td>
      </tr>
      <% if (frecuencia.primerPedido) { %>
        <tr>
          <td style="font-weight:600;">Primer pedido</td>
          <td><%= new Date(frecuencia.primerPedido).toLocaleDateString() %></td>
        </tr>
      <% } %>
      <% if (frecuencia.ultimoPedido) { %>
        <tr>
          <td style="font-weight:600;">Último pedido</td>
          <td><%= new Date(frecuencia.ultimoPedido).toLocaleDateString() %></td>
        </tr>
      <% } %>
    </tbody>
  </table>

  <% if (Object.keys(frecuencia.distribucionDias).length > 0) { %>
    <hr>
    <h6>Distribución por día</h6>
    <table>
      <thead>
        <tr>
          <th>Día</th>
          <th>Pedidos</th>
          <th style="width:60%;">Distribución</th>
        </tr>
      </thead>
      <tbody>
        <% 
          const entries = Object.entries(frecuencia.distribucionDias).sort((a, b) => b[1] - a[1]);
          const maxVal = Math.max(...entries.map(e => e[1]));
          const DIA_TRADUCIDO = { LUNES: 'Lunes', MARTES: 'Martes', MIERCOLES: 'Miércoles', JUEVES: 'Jueves', VIERNES: 'Viernes', SABADO: 'Sábado', DOMINGO: 'Domingo' };
        %>
        <% entries.forEach(([dia, count]) => { %>
          <tr>
            <td><%= DIA_TRADUCIDO[dia] || dia %></td>
            <td><strong><%= count %></strong></td>
            <td>
              <div style="background:#eee;border-radius:4px;height:18px;overflow:hidden;">
                <div style="background:<%= dia === frecuencia.diaSemanaFrecuente ? '#0066cc' : '#6ea8fe' %>;width:<%= (count / maxVal * 100).toFixed(0) %>%;height:100%;border-radius:4px;"></div>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</article>
<% } %>

<footer class="flex gap-2">
  <a href="/admin/clientes/<%= cliente.id %>/editar" role="button" class="primary">Editar</a>
  <% if (cliente.activo) { %>
    <form method="POST" action="/admin/clientes/<%= cliente.id %>/eliminar" data-confirm="¿Desactivar este cliente?">
      <button type="submit" class="primary outline">Desactivar</button>
    </form>
  <% } %>
</footer>

<%- include('../layouts/footer') %>
