# =========================
# APP CONFIG
# =========================
NODE_ENV=development
PORT=3000

# =========================
# DATABASE (PostgreSQL)
# =========================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/supplycycle

# =========================
# AUTH (JWT)
# =========================
JWT_SECRET=supplycycle-dev-secret-key-2026
JWT_EXPIRES_IN=24h

# =========================
# BCRYPT / SECURITY
# =========================
BCRYPT_SALT_ROUNDS=10
SESSION_SECRET=supplycycle-session-secret

# =========================
# CORS
# =========================
CORS_ORIGIN=*

# =========================
# LOGGING
# =========================
LOG_LEVEL=debug

# =========================
# WHATSAPP BOT
# =========================
BOT_API_KEY=sc-bot-dev-key-change-in-production
BOT_API_URL=http://localhost:3008
BOT_API_KEY_OUTGOING=sc-bot-outgoing-key-change-in-production

# =========================
# ENVASES / RF-12
# =========================
# Expresión cron para el job de detección de envases demorados (default: diario 8am)
CRON_ENVASES_DEMORADOS=0 8 * * *
