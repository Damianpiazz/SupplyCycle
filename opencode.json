{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "backend/AGENTS.md",
    "backend/rules/*.md",
    "mobile/AGENTS.md",
    "mobile/rules/*.md",
    "whatsapp-bot/AGENTS.md",
    "whatsapp-bot/rules/*.md"
  ],
  "permission": {
    "edit": "ask",
    "bash": { "*": "ask" },
    "skill": { "*": "deny" }
  },
  "agent": {
    "backend": {
      "mode": "primary",
      "description": "Desarrolla en backend (Express + Prisma + PostgreSQL)",
      "color": "#68A063",
      "prompt": "{file:.opencode/agents/backend.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "cd backend && npm run *": "allow",
          "cd backend && npx *": "allow",
          "cd backend && node *": "allow",
          "npm run dev": "allow",
          "npm run build": "allow",
          "npm test": "allow",
          "npm run test:coverage": "allow",
          "npx vitest*": "allow",
          "npx tsx*": "allow",
          "npx prisma*": "allow"
        },
        "skill": {
          "prisma-migrate": "allow",
          "api-authentication": "allow",
          "api-error-handling": "allow",
          "api-security-hardening": "allow",
          "express-typescript": "allow",
          "rest-api-design": "allow",
          "typescript-strict-mode": "allow",
          "prisma-orm-v7-skills": "allow",
          "backend-testing": "allow",
          "reglas-negocio": "allow"
        }
      }
    },
    "mobile": {
      "mode": "primary",
      "description": "Desarrolla en mobile (React Native / Expo)",
      "color": "#61DAFB",
      "prompt": "{file:.opencode/agents/mobile.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "cd mobile && npm run *": "allow",
          "cd mobile && npx *": "allow",
          "cd mobile && node *": "allow",
          "npm run lint": "allow",
          "npm test": "allow",
          "npm run test:coverage": "allow",
          "npx vitest*": "allow",
          "npx expo*": "allow"
        },
        "skill": {
          "add-screen": "allow",
          "mobile-offline-support": "allow",
          "react-native-web-navigation": "allow",
          "react-state-management": "allow",
          "vercel-react-native-skills": "allow",
          "typescript-react-reviewer": "allow",
          "ui-ux-pro-max": "allow"
        }
      }
    },
    "whatsapp-bot": {
      "mode": "primary",
      "description": "Desarrolla en whatsapp-bot (BuilderBot + Baileys QR + MemoryDB)",
      "color": "#25D366",
      "prompt": "{file:.opencode/agents/whatsapp-bot.md}",
      "permission": {
        "edit": "allow",
        "bash": {
          "*": "ask",
          "cd whatsapp-bot && npm run *": "allow",
          "cd whatsapp-bot && npx *": "allow",
          "cd whatsapp-bot && node *": "allow",
          "npm run dev": "allow",
          "npm run build": "allow",
          "npm run lint": "allow",
          "npm test": "allow",
          "npm run test:coverage": "allow",
          "npx vitest*": "allow"
        },
        "skill": {
          "add-flow": "allow",
          "whatsapp-cloud-api": "allow"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "description": "Planifica tareas y analiza requerimientos antes de implementar",
      "color": "#8B5CF6",
      "prompt": "Eres un arquitecto de software. Tu rol es analizar requerimientos, proponer soluciones y planificar la implementacion antes de escribir codigo. Nunca generes codigo directamente. Debes entregar planes claros con estimaciones y riesgos.",
      "permission": {
        "edit": "deny",
        "bash": "deny",
        "skill": {
          "documentation-writer": "allow"
        }
      }
    }
  }
}